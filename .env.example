# Server
PORT=10000
NODE_ENV=development
BASE_URL=http://localhost:10000

# Demo mode — shows clearly marked SAMPLE data, skips live GitHub calls
DEMO_MODE=true

# Session signing secret (long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# GitHub OAuth App (callback: ${BASE_URL}/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub usernames allowed to sign in
ALLOWED_GITHUB_USERS=cmiecz,mwaldau71

# Fine-grained PAT for reading cmiecz/waypathacademics (never sent to the browser)
GITHUB_TOKEN=
GITHUB_OWNER=cmiecz
GITHUB_REPO=waypathacademics

# Optional: verify GitHub webhook payloads for immediate refresh
GITHUB_WEBHOOK_SECRET=

# Bot events API — Authorization: Bearer <token>
BOT_EVENTS_TOKEN=change-me-bot-events-token

# Optional Postgres for durable bot events (falls back to in-memory)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Poll interval for GitHub (ms). Default 45000 (45s).
GITHUB_POLL_INTERVAL_MS=45000

# Optional: Cursor Cloud Agents API key (Basic auth to api.cursor.com)
# CURSOR_API_KEY=
